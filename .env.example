# OpenRouter API key (get one at https://openrouter.ai)
OPENROUTER_API_KEY=your_key_here

# Comma-separated origins allowed to call /api/* from a browser.
# Same-origin requests are always allowed, so this is only needed for
# extra origins (a custom domain, a preview deployment).
# ALLOWED_ORIGINS=https://yt-studio.vercel.app

# Per-IP request cap for /api/*. Defaults: 20 requests per 60s window.
# NOTE: the counter lives in each serverless instance's memory, so the real
# ceiling is (warm instances x RATE_LIMIT_MAX). Use a shared store for a hard cap.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
