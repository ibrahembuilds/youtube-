# OpenRouter API key (get one at https://openrouter.ai)
OPENROUTER_API_KEY=your_key_here

# ─── Model per task ───────────────────────────────────────────────────
# Any OpenRouter model id. Defaults shown; uncomment to override without a
# deploy. Prices are USD per 1M tokens (OpenRouter, 2026-09-12).
#
#   openai/gpt-5-nano           $0.05 in / $0.40 out / $0.005 cached
#   openai/gpt-5-mini           $0.25 in / $2.00 out / $0.025 cached
#   deepseek/deepseek-v4-flash  $0.07 in / $0.13 out / $0.013 cached
#
# Note: the gpt-5 tiers do NOT accept a temperature parameter. Structured
# output is controlled with response_format instead (see api/viral.js).
# AI_MODEL_CHAT=openai/gpt-5-nano
# AI_MODEL_SUMMARY=openai/gpt-5-nano
# AI_MODEL_VIRAL=openai/gpt-5-mini
# AI_MODEL_TRANSLATE=openai/gpt-5-mini

# ─── YouTube access ───────────────────────────────────────────────────
# YouTube blocks datacenter IPs (Vercel included): the watch page answers 429
# and every InnerTube client answers "Sign in to confirm you're not a bot".
# Route YouTube requests through a ROTATING RESIDENTIAL proxy. Datacenter
# ("Proxy Server") and static residential proxies get banned too.
# Webshare residential format (Proxy Settings page in their dashboard):
# YOUTUBE_PROXY_URL=http://USERNAME-rotate:PASSWORD@p.webshare.io:80

# Comma-separated origins allowed to call /api/* from a browser.
# Same-origin requests are always allowed, so this is only needed for
# extra origins (a custom domain, a preview deployment).
# ALLOWED_ORIGINS=https://yt-studio.vercel.app

# Per-IP request cap for /api/*. Defaults: 20 requests per 60s window.
# NOTE: the counter lives in each serverless instance's memory, so the real
# ceiling is (warm instances x RATE_LIMIT_MAX). Use a shared store for a hard cap.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
