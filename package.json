{
  "name": "yt-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c blue,green \"vite\" \"node api-server.js\"",
    "dev:client": "vite",
    "dev:api": "node api-server.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:reliability && npm run test:api && npm run test:e2e && node tests/languages.mjs",
    "test:reliability": "node --test tests/reliability.mjs",
    "test:unit": "node tests/units.mjs",
    "test:api": "node tests/api.mjs",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "test:lang": "npm run build && node tests/languages.mjs",
    "check": "node scripts/check-video.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "express": "^4.19.2",
    "globals": "^15.9.0",
    "playwright": "^1.56.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.3.4"
  }
}
